# ── Entorno ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Base de datos (Railway inyecta estas en deploy) ─────
# Local/migraciones: usa DATABASE_URL (pública de Railway o tu Postgres local)
# En producción Railway expone también DATABASE_PRIVATE_URL (red interna)
DATABASE_URL=postgresql://user:pass@host:5432/railway

# ── JWT (genera secretos fuertes y DISTINTOS por entorno) ─
# Generar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=cambia-esto-min-32-chars-aleatorios
JWT_REFRESH_SECRET=cambia-esto-otro-min-32-chars-aleatorios
ACCESS_TTL=15m
REFRESH_TTL_DAYS=7

# ── CORS (dominio del frontend; en prod NO uses *) ───────
CORS_ORIGIN=*

# ── Cloudflare R2 (S3-compatible) ────────────────────────
# Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_KEY=
R2_SECRET=
R2_BUCKET=elroi-evidencias-dev

# ── Sentry (monitoreo de errores; opcional) ─────────────
# Sin SENTRY_DSN el monitoreo queda inactivo (el API corre igual).
# DSN del proyecto en sentry.io. Usa proyectos/DSN distintos por entorno.
SENTRY_DSN=
# Muestreo de trazas de performance (0 = solo errores, 1 = todas). Prod: 0.1 sugerido.
SENTRY_TRACES_SAMPLE_RATE=0
# Release para Release Health. En Railway se toma solo de RAILWAY_GIT_COMMIT_SHA;
# define esto unicamente para forzar un valor manual.
SENTRY_RELEASE=

# Seed admin (solo para scripts/seed-admin.js)
SEED_ADMIN_EMAIL=admin@elroi.mx
SEED_ADMIN_PASSWORD=elroi2025
