{
  "name": "elroi-cargodesk-api",
  "version": "0.1.0",
  "description": "API Fastify para ELROI CargoDesk (Postgres en Railway + Cloudflare R2 + Auth JWT/Argon2)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate:up": "node migrations/migrate.js up",
    "migrate:status": "node migrations/migrate.js status",
    "seed:admin": "node scripts/seed-admin.js",
    "seed:superadmin": "node scripts/seed-superadmin.js",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.620.0",
    "@aws-sdk/s3-request-presigner": "^3.620.0",
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@sentry/node": "^10.55.0",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "jsonwebtoken": "^9.0.2",
    "otplib": "^12.0.1",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  }
}
